# Theme & Window
theme = Nord
window-theme = ghostty
window-decoration = none
window-save-state = always
confirm-close-surface = false
window-padding-x = 4
window-padding-y = 4
resize-overlay = always

# Font
font-family = Iosevka SS08
font-size = 11
font-feature = -calt, -liga
window-title-font-family = Iosevka SS08

# Mouse & Cursor
cursor-style-blink = true
mouse-hide-while-typing = true
# Write to both the primary and system clipboards
copy-on-select = both
focus-follows-mouse = true

# Terminal & Integration
command = direct:/home/odsod/.config/ghostty/ghostty-herdr.sh
# Handled by Herdr
scrollback-limit-bytes = 0

# Keybindings
# Release the mouse when a TUI or agent grabs mouse reporting
keybind = ctrl+shift+m=toggle_mouse_reporting

