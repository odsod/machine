#!/usr/bin/env bash
# Start or repair one of this computer's agents: the terminal named <agent> in
# space <agent>, tab <agent>, running Claude in its repo's original checkout.
# <agent> is `machine` (the default) or a vault: `brain`, `house` or
# `company`. A missing vault is cloned first. Safe to run any time. With
# arguments, send them to it as one message once Claude is up.
#
#   herdr-machine-agent [--agent <agent>] [<message>...]
#
# A kept terminal outlives a reboot as a shell in the same place, so a fresh
# start and a repair take the same path: a shell named <agent>, then `claude`
# typed into it (the login shell's environment, aliases included).
set -euo pipefail

name=machine
if [[ ${1:-} == --agent ]]; then
  name=${2:?--agent needs a name}
  shift 2
fi
log() { echo "[herdr-machine-agent] $name: $*" >&2; }
case $name in
machine) repo=$HOME/Code/github.com/odsod/machine ;;
brain | house | company)
  repo=$HOME/Code/git.lan/odsod/$name
  url=ssh://git@git.lan:2222/odsod/$name.git
  ;;
*)
  log "unknown agent (machine, brain, house or company)"
  exit 2
  ;;
esac
get() { hc get "$name" --json 2>/dev/null | jq -r "$1 // empty"; }

hc server status >/dev/null 2>&1 || {
  log "no herdr-core running"
  exit 1
}

if [[ ! -d $repo && -n ${url:-} ]]; then
  jj git clone "$url" "$repo" >&2
  log "cloned $url"
fi

state=$(get .state || true)
if [[ $state != live ]]; then
  [[ -n $state ]] && hc rm "$name" >/dev/null 2>&1 || true
  trust-workspace "$repo" >/dev/null
  hc run --bg --keep --no-parent --name "$name" \
    --label herdr.space="$name" --label herdr.tab="$name" --cwd "$repo" >/dev/null
  log "started a shell"
fi

if [[ $(get .status.app) != claude-code ]]; then
  case $(get .foreground.name) in
  "" | fish | bash | zsh | sh) ;;
  *)
    log "runs $(get .foreground.name), not a shell: left alone"
    exit 1
    ;;
  esac
  hc send "$name" claude >/dev/null
  log "started claude"
  # Claude reports its status once it is up; a message sent before that can be dropped.
  for _ in $(seq 60); do
    [[ $(get .status.app) == claude-code ]] && break
    sleep 1
  done
fi

(($#)) && hc send "$name" "$*" >/dev/null
exit 0
