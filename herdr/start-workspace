#!/usr/bin/env fish

test -n "$HERDR_PANE_ID"; and herdr pane rename "$HERDR_PANE_ID" workspace 2>/dev/null

command -q fzf; or exit 0

# --- Shared fzf helpers ---

function _fail --argument-names msg
    echo "$msg" >&2
    _trace "FAIL: $msg"
    exit 1
end

function _trace --argument-names msg
    if test -n "$START_WORKSPACE_DEBUG"
        mkdir -p "$HOME/.cache"
        printf '%s %s\n' (date '+%Y-%m-%d %H:%M:%S') "$msg" >> "$HOME/.cache/start-workspace.log"
    end
end

function _fzf_pick_compact --argument-names prompt
    fzf --prompt="$prompt> " --height=40% --reverse --bind='j:down,k:up'
end

function _fzf_pick_full --argument-names prompt
    fzf --prompt="$prompt> " --height=100% --reverse
end

function _fzf_pick_or_query --argument-names prompt
    fzf --prompt="$prompt> " --height=100% --reverse \
        --bind='tab:replace-query,enter:accept-or-print-query'
end

function _handle_fzf_status --argument-names status_code prompt
    switch "$status_code"
        case 0
            return 0
        case 1 130
            return 1
        case '*'
            echo "$prompt picker failed (fzf exit $status_code)" >&2
            exit 1
    end
end


function _last_non_empty_line
    set -l value
    for line in $argv
        set line (string trim -- "$line")
        if test -n "$line"
            set value "$line"
        end
    end
    test -n "$value"; or return 1
    printf '%s\n' "$value"
end

function _status_show --argument-names msg
    printf '\r\033[2K%s' "$msg"
end

function _status_clear
    printf '\r\033[2K'
end

function _workspace_label --argument-names base suffix
    if test -n "$suffix"
        printf '%s/%s\n' "$base" "$suffix"
    else
        printf '%s\n' "$base"
    end
end

function _relative_time --argument-names epoch now
    test -n "$now"; or set now (date +%s)
    set -l diff (math "$now - $epoch")
    if test $diff -lt 60
        printf '%ds ago' $diff
    else if test $diff -lt 3600
        printf '%dm ago' (math "floor($diff / 60)")
    else if test $diff -lt 86400
        printf '%dh ago' (math "floor($diff / 3600)")
    else if test $diff -lt 604800
        printf '%dd ago' (math "floor($diff / 86400)")
    else
        printf '%dw ago' (math "floor($diff / 604800)")
    end
end

function _build_bookmark_lines --argument-names workspace_base repo_path
    set -l bookmarks $argv[3..-1]
    set -l max_epoch 9999999999
    set -l age_width 9
    set -l now (date +%s)

    set -l epoch_map (_jj_repo "$repo_path" log --no-graph -r 'bookmarks() | remote_bookmarks()' \
        -T 'concat(local_bookmarks.map(|b| b.name() ++ " " ++ committer.timestamp().format("%s") ++ "\n").join(""), remote_bookmarks.filter(|b| b.remote() == "origin").map(|b| b.name() ++ "@origin " ++ committer.timestamp().format("%s") ++ "\n").join(""))' \
        2>/dev/null | sed '/^$/d')

    for bm in $bookmarks
        set -l ws_dir "$workspace_base/$bm"
        set -l mtime ""
        if test -d "$ws_dir"
            set mtime (stat -c '%Y' "$ws_dir" 2>/dev/null)
        end

        set -l matched (string match -r --groups-only "^"(string escape --style=regex -- "$bm")' (\d+)$' $epoch_map)
        set -l commit_epoch ""
        for ts in $matched
            if test -z "$commit_epoch" -o "$ts" -gt "$commit_epoch"
                set commit_epoch "$ts"
            end
        end

        set -l epoch ""
        if test -n "$mtime" -a -n "$commit_epoch"
            set epoch (math "max($mtime, $commit_epoch)")
        else if test -n "$mtime"
            set epoch "$mtime"
        else if test -n "$commit_epoch"
            set epoch "$commit_epoch"
        end

        if test -n "$epoch"
            set -l inverted (math "$max_epoch - $epoch")
            set -l age (string pad -r -w $age_width -- (_relative_time $epoch $now))
            printf '0_%010d %s%s\n' $inverted "$age" "$bm"
        else
            set -l spacer (string pad -r -w $age_width -- "")
            printf '1_0000000000 %s%s\n' "$spacer" "$bm"
        end
    end | sort
end

function _select_or_create_dir --argument-names base_dir prompt
    set -l dirs
    for d in "$base_dir"/*/
        test -d "$d"; or continue
        set -a dirs (basename "$d")
    end

    set -l chosen (printf '%s\n' $dirs | _fzf_pick_or_query "$prompt")
    set -l status_code $status
    _handle_fzf_status "$status_code" "$prompt"; or return 1

    set -l dir_name (_last_non_empty_line $chosen)
    test -n "$dir_name"; or return 1

    set -l target_dir "$base_dir/$dir_name"
    mkdir -p "$target_dir"
    or begin
        echo "Failed to create directory: $target_dir" >&2
        exit 1
    end

    printf '%s\n' "$target_dir"
end

function _select_existing_dir --argument-names base_dir prompt
    set -l dirs
    for d in "$base_dir"/*/
        test -d "$d"; or continue
        set -a dirs (basename "$d")
    end

    if test (count $dirs) -eq 0
        echo "No $prompt directories found in $base_dir." >&2
        return 1
    end

    set -l dir_name (printf '%s\n' $dirs | _fzf_pick_full "$prompt")
    set -l status_code $status
    _handle_fzf_status "$status_code" "$prompt"; or return 1
    test -n "$dir_name"; or return 1

    printf '%s\n' "$base_dir/$dir_name"
end

# --- Repo discovery ---

function discover_repos
    if command -q fd
        set -l repos
        for git_path in (fd --hidden --no-follow -d 4 --min-depth 4 -g '.git' "$HOME/Code" 2>/dev/null)
            set -l repo_dir (path dirname "$git_path")
            set -l rel (string replace "$HOME/Code/" "" -- "$repo_dir")
            if string match -rq '^[^/]+/[^/]+/[^/]+$' -- "$rel"
                set -a repos "$rel"
            end
        end
        printf '%s\n' $repos | sort -u
    else
        set repos
        for host_dir in $HOME/Code/*
            test -d $host_dir; or continue
            for org_dir in $host_dir/*
                test -d $org_dir; or continue
                for repo_dir in $org_dir/*
                    test -d $repo_dir; or continue
                    if test -d $repo_dir/.git; or test -f $repo_dir/.git
                        set rel (string replace -r "^$HOME/Code/" "" -- $repo_dir)
                        set -a repos $rel
                    end
                end
            end
        end
        printf '%s\n' $repos | sort -u
    end
end

function _pick_repo_rel --argument-names prompt
    set -l suggestions (discover_repos)
    if test (count $suggestions) -eq 0
        echo "No repos found in ~/Code." >&2
        return 1
    end
    set -l picked (printf '%s\n' $suggestions | _fzf_pick_full "$prompt")
    set -l status_code $status
    _handle_fzf_status "$status_code" "$prompt"; or return 1
    test -n "$picked"; or return 1
    printf '%s\n' "$picked"
end

function _jj_repo --argument-names repo_path
    jj --ignore-working-copy -R "$repo_path" $argv[2..-1]
end

function _jj_fetch_origin_for_picker --argument-names repo_path
    if command -q timeout
        timeout --kill-after=2s 10s jj --ignore-working-copy -R "$repo_path" git fetch --remote origin
    else
        jj --ignore-working-copy -R "$repo_path" git fetch --remote origin
    end
end

function _ensure_jj_repo_ready --argument-names repo_path
    if not test -d "$repo_path/.jj"
        jj git init --colocate "$repo_path" >/dev/null 2>&1
        or _fail "Failed to initialize jj in $repo_path"
    end

    set -l colocation_status (_jj_repo "$repo_path" git colocation status 2>&1)
    or _fail "$colocation_status"
    if not string match -rq "currently colocated" -- "$colocation_status"
        _jj_repo "$repo_path" git colocation enable >/dev/null 2>&1
        or _fail "Failed to enable jj/git colocation in $repo_path"
    end

    _jj_repo "$repo_path" git import >/dev/null 2>&1
    or _fail "Failed to import git refs into jj for $repo_path"
end

# --- Agent selection ---

function select_agent
    set agent_choice (printf '%s\n' claude codex cursor agy pi \
        | _fzf_pick_compact Agent)
    set status_code $status
    _handle_fzf_status "$status_code" Agent; or return 1

    switch "$agent_choice"
        case codex
            set -g agent_kind codex
            set -g agent_bin codex
        case agy
            set -g agent_kind agy
            set -g agent_bin agy
        case pi
            set -g agent_kind pi
            set -g agent_bin pi
        case claude
            set -g agent_kind claude
            set -g agent_bin claude
        case cursor
            set -g agent_kind cursor
            set -g agent_bin cursor
        case '*'
            echo "Unknown agent selection: $agent_choice" >&2
            return 1
    end

    command -q "$agent_bin"
    or begin
        echo "Selected agent command not found: $agent_bin" >&2
        return 1
    end
end

# --- Workspace trust ---

function _trust_claude --argument-names cwd
    command -q jq; or return 0
    set -l claude_file "$HOME/.claude.json"
    mkdir -p (dirname "$claude_file")
    if test -f "$claude_file"
        set -l tmp (mktemp)
        if jq --arg cwd "$cwd" \
                '.projects = ((.projects // {}) | .[$cwd] = ((.[$cwd] // {}) | .hasTrustDialogAccepted = true))' \
                "$claude_file" >"$tmp" 2>/dev/null
            mv "$tmp" "$claude_file"
        else
            rm -f "$tmp"
        end
    else
        jq -n --arg cwd "$cwd" \
            '{"projects": {($cwd): {"hasTrustDialogAccepted": true}}}' >"$claude_file" 2>/dev/null
    end
end

function _trust_codex --argument-names cwd
    set -l codex_file "$HOME/.codex/config.toml"
    mkdir -p (dirname "$codex_file")
    if not test -f "$codex_file"; or not grep -qF "[projects.\"$cwd\"]" "$codex_file" 2>/dev/null
        printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$cwd" >>"$codex_file"
    end
end

function _trust_cursor --argument-names cwd
    command -q jq; or return 0
    set -l slug (echo "$cwd" | string replace -r '^/' '' | string replace -ra '[^a-zA-Z0-9]+' '-')
    set -l cursor_dir "$HOME/.cursor/projects/$slug"
    mkdir -p "$cursor_dir"
    set -l ts (date -u +'%Y-%m-%dT%H:%M:%S.000Z')
    jq -n --arg ts "$ts" --arg cwd "$cwd" \
        '{"trustedAt": $ts, "workspacePath": $cwd, "trustMethod": "cli-flag"}' >"$cursor_dir/.workspace-trusted" 2>/dev/null
end

function _trust_agy --argument-names cwd
    command -q jq; or return 0
    set -l agy_file "$HOME/.gemini/antigravity-cli/settings.json"
    mkdir -p (dirname "$agy_file")
    if test -f "$agy_file"
        set -l tmp (mktemp)
        if jq --arg cwd "$cwd" \
                '.trustedWorkspaces = (((.trustedWorkspaces // []) + [$cwd]) | unique)' \
                "$agy_file" >"$tmp" 2>/dev/null
            mv "$tmp" "$agy_file"
        else
            rm -f "$tmp"
        end
    else
        jq -n --arg cwd "$cwd" \
            '{"trustedWorkspaces": [$cwd]}' >"$agy_file" 2>/dev/null
    end

    set -l gemini_file "$HOME/.gemini/trustedFolders.json"
    if test -f "$gemini_file"
        set -l tg (mktemp)
        if jq --arg cwd "$cwd" '.[$cwd] = "TRUST_FOLDER"' "$gemini_file" >"$tg" 2>/dev/null
            mv "$tg" "$gemini_file"
        else
            rm -f "$tg"
        end
    end
end

function _trust_pi --argument-names cwd
    command -q jq; or return 0
    set -l pi_file "$HOME/.pi/agent/trust.json"
    mkdir -p (dirname "$pi_file")
    if test -f "$pi_file"
        set -l tmp (mktemp)
        if jq --arg cwd "$cwd" \
                '.[$cwd] = true' \
                "$pi_file" >"$tmp" 2>/dev/null
            mv "$tmp" "$pi_file"
        else
            rm -f "$tmp"
        end
    else
        jq -n --arg cwd "$cwd" \
            '{($cwd): true}' >"$pi_file" 2>/dev/null
    end
end

function _trust_workspace --argument-names agent_kind cwd
    test -n "$cwd"; or return 0
    test -n "$agent_kind"; or return 0
    set cwd (string trim -r -c / -- "$cwd")

    switch "$agent_kind"
        case claude claude-code
            _trust_claude "$cwd"
        case codex
            _trust_codex "$cwd"
        case cursor cursor-agent
            _trust_cursor "$cwd"
        case agy antigravity antigravity-cli
            _trust_agy "$cwd"
        case pi
            _trust_pi "$cwd"
    end
end

# --- Workspace launcher ---

function _launch_workspace
    set -l label $argv[1]
    set -l cwd $argv[2]

    set -l workspace_json (herdr workspace list 2>&1 | string collect)
    test $status -eq 0; or _fail "Failed to list Herdr workspaces: $workspace_json"

    set -l label_ids (printf '%s\n' "$workspace_json" \
        | jq -r --arg label "$label" \
            '.result.workspaces[] | select(.label == $label) | .workspace_id' 2>/dev/null)
    test $status -eq 0; or _fail "Failed to parse Herdr workspaces."

    set -l matching_ids
    for candidate_id in $label_ids
        set -l pane_json (herdr pane list --workspace "$candidate_id" 2>/dev/null | string collect)
        test $status -eq 0; or continue

        set -l cwd_match (printf '%s\n' "$pane_json" \
            | jq -r --arg cwd "$cwd" '
                if any((.result.panes // [])[];
                    .cwd == $cwd or .foreground_cwd == $cwd or
                    ((.cwd // "") | startswith($cwd + "/")) or
                    ((.foreground_cwd // "") | startswith($cwd + "/")))
                then "1" else "" end
            ' 2>/dev/null)
        test $status -eq 0; or continue
        test "$cwd_match" = 1; and set -a matching_ids "$candidate_id"
    end

    if test (count $matching_ids) -gt 1
        _fail "Multiple Herdr workspaces match $label at $cwd."
    else if test (count $matching_ids) -eq 1
        herdr workspace focus "$matching_ids[1]"
        or _fail "Failed to focus Herdr workspace $matching_ids[1]."
    else
        set -l created (herdr workspace create --cwd "$cwd" --label "$label" --focus 2>/dev/null \
            | string collect)
        test $status -eq 0; or _fail "Failed to create Herdr workspace $label."

        set -l created_ids (printf '%s\n' "$created" \
            | jq -r '[.result.workspace.workspace_id, .result.root_pane.pane_id] | @tsv' 2>/dev/null)
        test $status -eq 0; or _fail "Failed to parse the created Herdr workspace."
        set created_ids (string split (printf '\t') -- "$created_ids")
        test (count $created_ids) -eq 2; or _fail "Created Herdr workspace returned incomplete IDs."

        set -l ws_id "$created_ids[1]"
        set -l pane_id "$created_ids[2]"
        set -l agent_name (string lower -- "$agent_kind-$ws_id" \
            | string replace -ar '[^a-z0-9_-]' '-')
        set agent_name (string sub -l 32 -- "$agent_name")

        _trust_workspace "$agent_kind" "$cwd"

        set -l agent_extra
        test "$agent_kind" = cursor; and set agent_extra -- --trust

        herdr agent start "$agent_name" --kind "$agent_kind" --pane "$pane_id" $agent_extra >/dev/null 2>&1 &
        disown
    end
end

# --- Machine helpers ---

function _get_remote_machines
    command -q herdr; or return 0
    command -q jq; or return 0
    herdr machine list --json 2>/dev/null \
        | jq -r '.[] | select(.enabled == true) | .label' 2>/dev/null
end

function _get_machine_target --argument-names label
    command -q herdr; or return 1
    command -q jq; or return 1
    herdr machine list --json 2>/dev/null \
        | jq -r --arg label "$label" '.[] | select(.label == $label) | .target' 2>/dev/null
end

function _get_machine_session --argument-names label
    command -q herdr; or return 1
    command -q jq; or return 1
    herdr machine list --json 2>/dev/null \
        | jq -r --arg label "$label" '.[] | select(.label == $label) | .session // empty' 2>/dev/null
end

# --- Machine selection ---

set -l chosen_machine ""
for i in (seq (count $argv))
    switch "$argv[$i]"
        case --local
            set chosen_machine Local
        case --machine
            set -l next_idx (math "$i + 1")
            if test $next_idx -le (count $argv)
                set chosen_machine "$argv[$next_idx]"
            end
    end
end

if test -z "$chosen_machine"
    set -l available_machines Local
    for m in (_get_remote_machines)
        test -n "$m"; and set -a available_machines "$m"
    end

    set chosen_machine (printf '%s\n' $available_machines | _fzf_pick_compact Machine)
    set -l status_code $status
    _handle_fzf_status "$status_code" Machine; or exit 0
    set chosen_machine (string trim -- "$chosen_machine")
end

test -n "$chosen_machine"; or exit 0
_trace "machine: selected $chosen_machine"

if test "$chosen_machine" != Local
    set -l target (_get_machine_target "$chosen_machine")
    test -n "$target"; or set target "$chosen_machine"
    set -l session (_get_machine_session "$chosen_machine")
    set -l cmd "start-workspace --local"
    if test -n "$session" -a "$session" != default
        set cmd "env HERDR_SESSION=$session $cmd"
    end
    _trace "machine: connecting to $target with $cmd"
    ssh -q -t "$target" "$cmd"
    set -l ssh_status $status
    if test $ssh_status -ne 0
        echo "Failed to start workspace on $chosen_machine (SSH exit $ssh_status)." >&2
        sleep 2
        exit $ssh_status
    end
    exit 0
end

# --- Type selection ---

set space_type (printf '%s\n' Workspace Code Activity Project Vault \
    | _fzf_pick_compact Space)
set status_code $status
_handle_fzf_status "$status_code" Space; or exit 0

# --- Activity ---

if test "$space_type" = Activity
    set ws_root (_select_or_create_dir "$HOME/Activities" Activity)
    or exit 0

    select_agent; or exit 0

    set dir_name (basename "$ws_root")
    set ws_label (_workspace_label "$dir_name")

    _launch_workspace $ws_label $ws_root
    exit 0
end

# --- Project ---

if test "$space_type" = Project
    set existing_projects
    for d in "$HOME/Projects"/*/
        test -d "$d"; and set -a existing_projects (basename "$d")
    end

    set ws_root (_select_or_create_dir "$HOME/Projects" Project)
    or exit 0

    set dir_name (basename "$ws_root")
    if not contains -- "$dir_name" $existing_projects
        if not string match -rq '^[0-9]{4}-[0-9]{2}-[0-9]{2}-' -- "$dir_name"
            set dated_name (date '+%Y-%m-%d')-$dir_name
            set dated_root "$HOME/Projects/$dated_name"
            mv "$ws_root" "$dated_root"
            set ws_root "$dated_root"
            set dir_name "$dated_name"
        end
    end

    select_agent; or exit 0

    set ws_label (_workspace_label "$dir_name")

    _launch_workspace $ws_label $ws_root
    exit 0
end

# --- Vault ---

if test "$space_type" = Vault
    set ws_root (_select_existing_dir "$HOME/Vaults" Vault)
    or exit 0

    select_agent; or exit 0

    set dir_name (basename "$ws_root")
    set ws_label (_workspace_label "Vaults" "$dir_name")

    _launch_workspace $ws_label $ws_root
    exit 0
end

# --- Code ---

if test "$space_type" = Code
    set repo_rel (_pick_repo_rel Code)
    or exit 0

    select_agent; or exit 0

    command -q jj
    or begin
        echo "jj is required for Code spaces: not found in PATH." >&2
        exit 1
    end

    set repo_path "$HOME/Code/$repo_rel"
    _ensure_jj_repo_ready "$repo_path"

    set repo_parts (string split '/' -- $repo_rel)
    set ws_label (_workspace_label (string join '/' -- $repo_parts[-2..-1]))

    _launch_workspace $ws_label "$repo_path"
    exit 0
end

# --- Workspace (jj worktree) ---

if test "$space_type" = Workspace
    command -q jj; or exit 0

    _trace "workspace: begin"
    set repo_rel (_pick_repo_rel Workspace)
    or exit 0

    set repo_path "$HOME/Code/$repo_rel"
    set repo_parts (string split '/' -- $repo_rel)
    set repo_name $repo_parts[-1]
    _ensure_jj_repo_ready "$repo_path"

    _jj_fetch_origin_for_picker "$repo_path" >/dev/null 2>&1 &
    set -l fetch_pid $last_pid

    set local_bookmarks (_jj_repo "$repo_path" bookmark list -T 'self.name() ++ "\n"' 2>/dev/null | sed '/^$/d' | sort -u)
    set remote_bookmarks (_jj_repo "$repo_path" log --no-graph -r 'remote_bookmarks(remote=origin)' \
        -T 'remote_bookmarks.filter(|rb| rb.remote() == "origin" && !local_bookmarks.any(|lb| lb.name() == rb.name())).map(|b| b.name() ++ "@origin\n").join("")' 2>/dev/null \
        | sed '/^$/d' \
        | sort -u)
    set suggestion_bookmarks (printf '%s\n' $local_bookmarks $remote_bookmarks | sed '/^$/d' | sort -u)

    set bookmark_input ""
    if test (count $suggestion_bookmarks) -gt 0
        set -l workspace_base "$HOME/Workspaces/$repo_rel"
        set -l decorated (_build_bookmark_lines "$workspace_base" "$repo_path" $suggestion_bookmarks)
        set bookmark_input (printf '%s\n' $decorated \
            | fzf --prompt="Bookmark> " --height=100% --reverse \
                --bind='tab:transform-query(echo {} | cut -c23-),enter:accept-or-print-query' \
                --with-nth=2..)
    else
        set bookmark_input (printf '\n' | _fzf_pick_or_query Bookmark)
    end
    set status_code $status
    _handle_fzf_status "$status_code" Bookmark; or begin
        kill $fetch_pid 2>/dev/null
        exit 0
    end

    set -l raw_line (_last_non_empty_line $bookmark_input)
    if string match -rq '^\d+_\d+ ' -- "$raw_line"
        set selected_bookmark (string sub -s 23 -- "$raw_line")
    else
        set selected_bookmark "$raw_line"
    end
    test -n "$selected_bookmark"; or exit 0
    _trace "workspace: repo=$repo_rel bookmark=$selected_bookmark"

    set bookmark "$selected_bookmark"
    set selected_remote_ref ""
    set selected_remote_parts (string match -r --groups-only '^(.+)@origin$' -- "$selected_bookmark")
    if test (count $selected_remote_parts) -eq 1
        set bookmark "$selected_remote_parts[1]"
        set selected_remote_ref "$selected_bookmark"
    end

    if not string match -rq '^[A-Za-z0-9._/-]+$' -- "$bookmark"
        echo "Invalid bookmark name: $selected_bookmark" >&2
        exit 1
    end

    set desired_workspace_path "$HOME/Workspaces/$repo_rel/$bookmark"
    set workspace_path "$desired_workspace_path"
    set existing_workspace_path (_jj_repo "$repo_path" workspace root --name "$bookmark" 2>/dev/null)
    if test $status -eq 0
        if test -n "$existing_workspace_path"
            if test -d "$existing_workspace_path"
                set workspace_path "$existing_workspace_path"
            else
                _jj_repo "$repo_path" workspace forget "$bookmark" >/dev/null 2>&1 || true
            end
        end
    end

    set workspace_parent (dirname "$workspace_path")
    set bookmark_exists 0
    if contains -- "$bookmark" $local_bookmarks
        set bookmark_exists 1
    end
    _status_show "Setting up worktree..."

    if test -d "$workspace_path"
        _trace "workspace: existing path $workspace_path"
        jj --ignore-working-copy -R "$workspace_path" root >/dev/null 2>&1
        or begin
            _status_clear
            echo "Path exists but is not a jj workspace: $workspace_path" >&2
            _trace "workspace: existing path is not jj workspace"
            echo "Move/remove that directory and retry." >&2
            exit 1
        end
        jj -R "$workspace_path" workspace update-stale >/dev/null 2>&1
        or begin
            _status_clear
            echo "Failed to refresh stale workspace at $workspace_path" >&2
            _trace "workspace: existing workspace update-stale failed"
            exit 1
        end
    else
        mkdir -p "$workspace_parent"
        or begin
            _status_clear
            echo "Failed to create workspace parent: $workspace_parent" >&2
            _trace "workspace: mkdir failed $workspace_parent"
            exit 1
        end

        if test -n "$selected_remote_ref"
            if not _jj_repo "$repo_path" log -r "$selected_remote_ref" --no-graph --limit 1 >/dev/null 2>&1
                wait $fetch_pid 2>/dev/null
            end
            _jj_repo "$repo_path" log -r "$selected_remote_ref" --no-graph --limit 1 >/dev/null 2>&1
            or begin
                _status_clear
                echo "Missing remote bookmark $selected_remote_ref in $repo_path." >&2
                _trace "workspace: missing remote ref $selected_remote_ref"
                exit 1
            end
            set base_rev "$selected_remote_ref"
        else
            set origin_bookmark_exists 0
            _jj_repo "$repo_path" log -r "$bookmark@origin" --no-graph --limit 1 >/dev/null 2>&1
            and set origin_bookmark_exists 1

            if test $origin_bookmark_exists -eq 1
                set base_rev "$bookmark@origin"
                set selected_remote_ref "$bookmark@origin"
            else if test $bookmark_exists -eq 1
                set base_rev "$bookmark"
            else if _jj_repo "$repo_path" log -r 'main@origin' --no-graph --limit 1 >/dev/null 2>&1
                set base_rev 'main@origin'
            else if _jj_repo "$repo_path" log -r 'main' --no-graph --limit 1 >/dev/null 2>&1
                set base_rev 'main'
            else
                wait $fetch_pid 2>/dev/null
                if _jj_repo "$repo_path" log -r 'main@origin' --no-graph --limit 1 >/dev/null 2>&1
                    set base_rev 'main@origin'
                else
                    set base_rev '@'
                end
            end
        end
        _trace "workspace: creating with base_rev=$base_rev path=$workspace_path"

        _jj_repo "$repo_path" workspace forget "$bookmark" >/dev/null 2>&1 || true

        jj -R "$repo_path" workspace update-stale >/dev/null 2>&1
        or begin
            _status_clear
            echo "Failed to refresh stale workspace in $repo_path" >&2
            _trace "workspace: workspace update-stale failed"
            exit 1
        end

        jj -R "$repo_path" workspace add --name "$bookmark" -r "$base_rev" "$workspace_path" >/dev/null 2>&1
        or begin
            _status_clear
            echo "Failed to create workspace at $workspace_path" >&2
            _trace "workspace: workspace add failed"
            exit 1
        end

        if test -n "$selected_remote_ref"
            jj --ignore-working-copy -R "$workspace_path" bookmark track "$bookmark" --remote=origin >/dev/null 2>&1 || true
        else if test $bookmark_exists -eq 0
            jj --ignore-working-copy -R "$workspace_path" bookmark set "$bookmark" -r @ >/dev/null 2>&1
            or begin
                _status_clear
                echo "Failed to create bookmark $bookmark in $workspace_path" >&2
                _trace "workspace: bookmark set failed for $bookmark"
                exit 1
            end
        end
    end

    _status_clear
    _trace "workspace: selecting agent"
    select_agent; or exit 0
    _trace "workspace: launching"

    set ws_label (_workspace_label "$repo_name" "$bookmark")

    _launch_workspace $ws_label "$workspace_path"
    exit 0
end
