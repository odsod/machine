#!/usr/bin/env fish

source (path dirname (realpath (status filename)))/lib.fish
or begin
    echo "Failed to load herdr/lib.fish" >&2
    exit 1
end

function _load_open_dirs
    set -l pane_json (herdr pane list 2>/dev/null | string collect)
    test $status -eq 0
        or _fail "Could not read Herdr panes. No workspace was removed."

    set -l parsed_dirs (printf '%s\n' "$pane_json" \
        | jq -r '.result.panes[] | [.cwd, .foreground_cwd] | .[] | select(type == "string" and length > 0)' 2>/dev/null)
    test $status -eq 0
        or _fail "Could not parse Herdr panes. No workspace was removed."
    set -g open_dirs $parsed_dirs
end

function _path_is_open --argument-names workspace_path
    for open_dir in $open_dirs
        set -l canonical_open (realpath -m -- "$open_dir" 2>/dev/null)
        if test "$canonical_open" = "$workspace_path"
            return 0
        end
        if string match -q -- "$workspace_path/*" "$canonical_open"
            return 0
        end
    end
    return 1
end

function _herdr_workspace_ids_for_path --argument-names workspace_path
    command -q herdr; or return 0
    command -q jq; or return 0
    set -l ws_ids (herdr workspace list 2>/dev/null \
        | jq -r '.result.workspaces[]?.workspace_id' 2>/dev/null)
    for ws_id in $ws_ids
        set -l matches (herdr pane list --workspace "$ws_id" 2>/dev/null \
            | jq -r --arg p "$workspace_path" '
                (.result.panes // [])[]
                | (.cwd // ""), (.foreground_cwd // "")
                | select(. == $p or startswith($p + "/"))' 2>/dev/null)
        test -n "$matches"; and printf '%s\n' "$ws_id"
    end
end

for dependency in fd fzf gio herdr jj jq realpath
    command -q "$dependency"
        or _fail "$dependency is required but not found in PATH."
end

set -l workspace_base "$HOME/Workspaces"
if set -q REMOVE_JJ_WORKSPACE_ROOT
    set workspace_base "$REMOVE_JJ_WORKSPACE_ROOT"
end

test -d "$workspace_base"
    or _fail "Workspace directory not found: $workspace_base"

set workspace_base (realpath -m -- "$workspace_base")
_load_open_dirs

set -l candidates
for jj_dir in (fd --hidden --no-ignore --type d '^\.jj$' "$workspace_base" 2>/dev/null)
    set -l workspace_path (realpath -m -- (dirname "$jj_dir"))
    string match -q -- "$workspace_base/*" "$workspace_path"; or continue

    set -l workspace_name (jj --ignore-working-copy -R "$workspace_path" workspace list \
        -T 'if(self.target().current_working_copy(), self.name(), "") ++ "\n"' \
        2>/dev/null | string match -rv '^$' | head -n1)
    test -n "$workspace_name"; or continue

    set -l default_root (jj --ignore-working-copy -R "$workspace_path" \
        workspace root --name default 2>/dev/null)
    test -n "$default_root"; or continue
    set default_root (realpath -m -- "$default_root")

    if test "$workspace_name" = default; or test "$workspace_path" = "$default_root"
        continue
    end

    jj --ignore-working-copy -R "$workspace_path" log -r @ --no-graph --limit 1 >/dev/null 2>&1
    or begin
        echo "Skipping unreadable jj workspace: $workspace_path" >&2
        continue
    end

    set -l empty_flag (jj --ignore-working-copy -R "$workspace_path" log -r @ \
        --no-graph -T 'if(empty, "1", "0")' 2>/dev/null | string collect)
    test -n "$empty_flag"; or continue

    set -l state clean
    test "$empty_flag" = 1; or set state changes
    _path_is_open "$workspace_path"; and set state open

    set -l epoch (stat -c '%Y' "$workspace_path")
    set -l age (_relative_time "$epoch")
    set -l repo_name (basename "$default_root")
    set -a candidates (printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$epoch" "$workspace_path" "$age" "$state" "$repo_name" "$workspace_name")
end

if test (count $candidates) -eq 0
    echo "No removable jj workspaces found in $workspace_base."
    exit 0
end

set -l sorted (printf '%s\n' $candidates \
    | sort -t (printf '\t') -k1,1nr \
    | cut -f2-)
set -l selection (printf '%s\n' $sorted \
    | _fzf_pick Remove 100% history \
        --delimiter='\t' --with-nth=2.. \
        --header='AGE  STATE  REPO  WORKSPACE')
set -l fzf_status $status
switch "$fzf_status"
    case 0
    case 1 130
        exit 0
    case '*'
        _fail "Workspace picker failed (fzf exit $fzf_status)."
end

test -n "$selection"; or exit 0
set -l fields (string split (printf '\t') -- "$selection")
test (count $fields) -eq 5
    or _fail "Could not parse selected workspace."

set -l workspace_path (realpath -m -- "$fields[1]")
set -l workspace_name "$fields[5]"
string match -q -- "$workspace_base/*" "$workspace_path"
    or _fail "Refusing to remove a path outside $workspace_base."

set -l default_root (jj --ignore-working-copy -R "$workspace_path" \
    workspace root --name default 2>/dev/null)
test -n "$default_root"
    or _fail "Could not determine the default checkout for $workspace_name."
set default_root (realpath -m -- "$default_root")

if test "$workspace_name" = default; or test "$workspace_path" = "$default_root"
    _fail "Refusing to remove the default jj workspace."
end

set -l herdr_ids (_herdr_workspace_ids_for_path "$workspace_path")
set -l caller_ws "$HERDR_ACTIVE_WORKSPACE_ID"
test -n "$caller_ws"; or set caller_ws "$HERDR_WORKSPACE_ID"
if test -n "$caller_ws"; and contains -- "$caller_ws" $herdr_ids
    _fail "Refusing to remove the workspace you are currently in."
end

echo "Workspace: $workspace_name"
echo "Path:      $workspace_path"
if test (count $herdr_ids) -gt 0
    echo "Herdr:     "(string join ', ' -- $herdr_ids)
end
echo
jj -R "$workspace_path" status --no-pager
or _fail "Could not snapshot $workspace_name. No workspace was removed."
echo

set -l action "Move this workspace to trash?"
if test (count $herdr_ids) -gt 0
    set action "Close its Herdr workspace and move it to trash?"
end
read -l -P "$action [y/N] " confirmation
string match -rqi '^y(es)?$' -- "$confirmation"; or exit 0

for ws_id in $herdr_ids
    herdr workspace close "$ws_id" >/dev/null 2>&1
    or echo "Warning: failed to close Herdr workspace $ws_id." >&2
end

jj --ignore-working-copy -R "$default_root" workspace forget "$workspace_name"
or _fail "Failed to forget jj workspace '$workspace_name'. Nothing was removed."

gio trash "$workspace_path"
or begin
    echo "Forgot jj workspace '$workspace_name', but failed to move $workspace_path to trash." >&2
    echo "The directory is still on disk. Remove it manually when ready." >&2
    exit 1
end

echo "Closed and removed jj workspace '$workspace_name'."
echo "The bookmark and commits were kept."
