#!/usr/bin/env fish

test -n "$HERDR_PANE_ID"; and herdr pane rename "$HERDR_PANE_ID" urls 2>/dev/null

set pane_id $HERDR_PANE_ID
if test -z "$pane_id"
    set pane_id (herdr pane current --current 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null)
end

if test -z "$pane_id"
    echo "No active Herdr pane detected." >&2
    sleep 1
    exit 1
end

set raw_text (herdr pane read "$pane_id" --source recent-unwrapped --lines 2000 2>/dev/null)
if test -z "$raw_text"
    echo "No text in pane." >&2
    sleep 1
    exit 0
end

set urls (printf '%s\n' $raw_text | \
    grep -oP 'https?://[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)+(?:[:/][a-zA-Z0-9._%+~:/?#@!$&()*,;=-]*[a-zA-Z0-9/=_~#)-])?' | \
    tac | \
    awk '{
        url = $0
        opens = gsub(/\(/, "&", url)
        closes = gsub(/\)/, "&", url)
        while (closes > opens && url ~ /\)$/) {
            sub(/\)$/, "", url)
            closes--
        }
        if (!seen[url]++) print url
    }')

if test -z "$urls"
    echo "No URLs found in active pane." >&2
    sleep 1
    exit 0
end

set selected_url (printf '%s\n' $urls | fzf \
    --prompt="Open URL> " \
    --height=100% \
    --reverse \
    --no-multi \
    --bind='j:down,k:up')

if test -n "$selected_url"
    open-url "$selected_url"
end
