+// ~/Workspaces/<host>/<org>/<repo>/<name> its workspaces. Both group under the
+// repo, keyed by the folder the space was made in, so no git look is needed.
+const ROOT = /^(.*)\/(Code|Workspaces)\/([^/]+\/[^/]+\/[^/]+)(?:\/(.+))?$/;
+function root(s) {
+  const m = ROOT.exec((s.folder ?? "").replace(/\/+$/, ""));
+  if (!m || (m[2] === "Code") === Boolean(m[4])) return null;
