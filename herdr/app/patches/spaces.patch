+// odsod: ~/Code/<host>/<org>/<repo> is a repo's original checkout and
+// ~/Workspaces/<host>/<org>/<repo>/<name> its workspaces. Both group under the
+// repo, keyed by the folder the space was made in, so no git look is needed.
+// A space made elsewhere (at ~) goes by where its first terminal is now
+// (`cwd`), anywhere in a checkout.
+const ROOT = /^(.*)\/(Code|Workspaces)\/([^/]+\/[^/]+\/[^/]+)(?:\/(.+))?$/;
+function root(s, cwd) {
+  const machine = s.machine ?? null;
+  const at = (path, loose) => {
+    const m = ROOT.exec((path ?? "").replace(/\/+$/, ""));
+    if (!m || (m[2] === "Workspaces" && !m[4]) || (m[2] === "Code" && m[4] && !loose)) return null;
+    return { key: JSON.stringify([machine, m[3]]), machine, code: `${m[1]}/Code/${m[3]}`, label: m[3].split("/").slice(1).join("/"), rest: m[2] === "Code" ? null : m[4] };
+  };
+  return at(s.folder, false) ?? at(cwd, true);
+}
