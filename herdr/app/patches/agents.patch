+const ROW = { section: 28, sectionPad: 4, sectionGap: 24, place: 16, placeGap: 12 };
+// odsod: ~/Code/<host>/<org>/<repo> is a repo's original checkout and
+// ~/Workspaces/<host>/<org>/<repo>/<name> its workspaces (same as odsod-spaces).
+// A space made elsewhere (at ~) goes by where its first terminal is now.
+const ROOT = /^(.*)\/(Code|Workspaces)\/([^/]+\/[^/]+\/[^/]+)(?:\/(.+))?$/;
+function root(s, ps) {
+  const at = (path, loose) => {
+    const m = ROOT.exec((path ?? "").replace(/\/+$/, ""));
+    if (!m || (m[2] === "Workspaces" && !m[4]) || (m[2] === "Code" && m[4] && !loose)) return null;
+    return { key: JSON.stringify([s.machine ?? null, m[3]]), label: m[3].split("/").slice(1).join("/"), rest: m[2] === "Code" ? null : m[4] };
+  };
+  const tabs = new Set((s.tabs ?? []).map((c) => c.id));
+  return at(s.folder, false) ?? at(ps.find((p) => tabs.has(p.tab) && p.cwd)?.cwd, true);
+}
 
