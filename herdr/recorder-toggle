#!/usr/bin/env fish

set -l ws_label recording

set -l ws_id (herdr workspace list 2>/dev/null \
    | jq -r ".result.workspaces[] | select(.label == \"$ws_label\") | .workspace_id" 2>/dev/null)

if test -n "$ws_id"
    herdr workspace close "$ws_id"
else
    herdr workspace create --label "$ws_label" --focus
    set -l pane_id (herdr pane current 2>/dev/null \
        | jq -r '.result.pane.pane_id' 2>/dev/null)
    if test -n "$pane_id"
        herdr pane send-text "$pane_id" "recorder run
"
    end
end
